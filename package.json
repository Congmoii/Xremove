{
  "name": "xremove",
  "private": true,
  "version": "1.1.2",
  "description": "Local-first desktop utility for inspecting and cleaning supported watermark and provenance traces.",
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/ensure_model.mjs && vite build",
    "preview": "vite preview",
    "test": "node scripts/ensure_model.mjs && node --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "bootstrap:vendor": "node scripts/bootstrap_vendor.mjs",
    "fetch:model": "node scripts/ensure_model.mjs",
    "build:release": "node scripts/create_release.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "gemini-watermark-remover": "github:GargantuaX/gemini-watermark-remover#bef0303a437902286a18ab4d1586629f198b90b7",
    "onnxruntime-web": "1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
